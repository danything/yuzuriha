{
	"compilerOptions": {
		"target": "ESNext",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": [
			"bun"
		],
		"lib": [
			"ESNext",
			"DOM",
			"DOM.Iterable"
		]
	},
	"include": [
		"*.ts",
		"sources/*.ts",
		"src/*.ts"
	]
}
